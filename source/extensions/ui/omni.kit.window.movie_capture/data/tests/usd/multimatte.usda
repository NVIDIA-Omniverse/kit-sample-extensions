def Xform "Environment"
{
    double3 xformOp:rotateXYZ = (0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:exposure = 1.5
        float inputs:intensity = 3000
        bool inputs:normalize = 1
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        custom int omni:rtx:usdluxVersion = 2505
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

def "Render" (
    hide_in_stage_window = true
    no_delete = true
)
{
    def "OmniverseKit"
    {
        def "HydraTextures" (
            hide_in_stage_window = true
            no_delete = true
        )
        {
            def RenderProduct "omni_kit_widget_viewport_ViewportTexture_0" (
                prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
                hide_in_stage_window = true
                no_delete = true
            )
            {
                rel camera = </OmniverseKit_Persp>
                rel orderedVars = </Render/Vars/LdrColor>
                custom bool overrideClipRange = 0
                uniform int2 resolution = (1280, 720)
            }
        }
    }

    def RenderSettings "OmniverseGlobalRenderSettings" (
        prepend apiSchemas = ["OmniRtxSettingsGlobalRtAdvancedAPI_1", "OmniRtxSettingsGlobalPtAdvancedAPI_1"]
        no_delete = true
    )
    {
        rel products = </Render/OmniverseKit/HydraTextures/omni_kit_widget_viewport_ViewportTexture_0>
    }

    def "Vars"
    {
        def RenderVar "LdrColor"
        {
            uniform string sourceName = "LdrColor"
        }

        def RenderVar "HdrColor"
        {
            uniform string sourceName = "HdrColor"
        }

        def RenderVar "PtDirectIllumation"
        {
            uniform string sourceName = "PtDirectIllumation"
        }

        def RenderVar "PtGlobalIllumination"
        {
            uniform string sourceName = "PtGlobalIllumination"
        }

        def RenderVar "PtReflections"
        {
            uniform string sourceName = "PtReflections"
        }

        def RenderVar "PtRefractions"
        {
            uniform string sourceName = "PtRefractions"
        }

        def RenderVar "PtSelfIllumination"
        {
            uniform string sourceName = "PtSelfIllumination"
        }

        def RenderVar "PtBackground"
        {
            uniform string sourceName = "PtBackground"
        }

        def RenderVar "PtWorldNormal"
        {
            uniform string sourceName = "PtWorldNormal"
        }

        def RenderVar "PtWorldPos"
        {
            uniform string sourceName = "PtWorldPos"
        }

        def RenderVar "PtZDepth"
        {
            uniform string sourceName = "PtZDepth"
        }

        def RenderVar "PtVolumes"
        {
            uniform string sourceName = "PtVolumes"
        }

        def RenderVar "PtMultiMatte0"
        {
            uniform string sourceName = "PtMultiMatte0"
        }

        def RenderVar "PtMultiMatte1"
        {
            uniform string sourceName = "PtMultiMatte1"
        }

        def RenderVar "PtMultiMatte2"
        {
            uniform string sourceName = "PtMultiMatte2"
        }

        def RenderVar "PtMultiMatte3"
        {
            uniform string sourceName = "PtMultiMatte3"
        }

        def RenderVar "PtMultiMatte4"
        {
            uniform string sourceName = "PtMultiMatte4"
        }

        def RenderVar "PtMultiMatte5"
        {
            uniform string sourceName = "PtMultiMatte5"
        }

        def RenderVar "PtMultiMatte6"
        {
            uniform string sourceName = "PtMultiMatte6"
        }

        def RenderVar "PtMultiMatte7"
        {
            uniform string sourceName = "PtMultiMatte7"
        }
    }

    def RenderProduct "RenderView"  (
        prepend apiSchemas = ["OmniRtxSettingsCommonAdvancedAPI_1", "OmniRtxSettingsRtAdvancedAPI_1", "OmniRtxSettingsPtAdvancedAPI_1", "OmniRtxPostColorGradingAPI_1", "OmniRtxPostChromaticAberrationAPI_1", "OmniRtxPostBloomPhysicalAPI_1", "OmniRtxPostMatteObjectAPI_1", "OmniRtxPostCompositingAPI_1", "OmniRtxPostDofAPI_1", "OmniRtxPostMotionBlurAPI_1", "OmniRtxPostTvNoiseAPI_1", "OmniRtxPostTonemapIrayReinhardAPI_1", "OmniRtxPostDebugSettingsAPI_1", "OmniRtxDebugSettingsAPI_1"]
    )
    {
        rel camera = </OmniverseKit_Persp>
        rel orderedVars = [
            </Render/Vars/LdrColor>,
            </Render/Vars/HdrColor>,
            </Render/Vars/PtDirectIllumation>,
            </Render/Vars/PtGlobalIllumination>,
            </Render/Vars/PtReflections>,
            </Render/Vars/PtRefractions>,
            </Render/Vars/PtSelfIllumination>,
            </Render/Vars/PtBackground>,
            </Render/Vars/PtWorldNormal>,
            </Render/Vars/PtWorldPos>,
            </Render/Vars/PtZDepth>,
            </Render/Vars/PtVolumes>,
            </Render/Vars/PtMultiMatte0>,
