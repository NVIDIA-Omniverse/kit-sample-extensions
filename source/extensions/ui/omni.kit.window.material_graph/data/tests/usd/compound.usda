#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
)

def Xform "Root"
{
    def NodeGraph "NodeGraph" (
        apiSchemas = ["NodeGraphNodeAPI"]
        customData = {
            dictionary omni = {
                dictionary ui = {
                    dictionary nodegraph = {
                        dictionary node = {
                            dictionary pos = {
                                float2 mdl = (-388.1726, -20.227346)
                            }
                        }
                    }
                }
            }
        }
    )
    {
        color3f inputs:color_const_c.connect = </World/Looks/Material/color_const_01.outputs:out>
        float3 inputs:float3_const_f3.connect = </World/Looks/Material/float3_const_01.outputs:out>
        token outputs:dusty_diffuse_out.connect = </Root/NodeGraph/dusty_diffuse.outputs:out>
        token ui:displayGroup = "Material Graphs"
        token ui:displayName = "NodeGraph"
        int ui:order = 1024
        uniform token[] xformOpOrder = []

        def Shader "dusty_diffuse" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @nvidia/core_definitions.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "dusty_diffuse"
            color3f inputs:diffuse_color.connect = </Root/NodeGraph/color_const.outputs:out>
            float3 inputs:normal.connect = </Root/NodeGraph/float3_const.outputs:out>
            token outputs:out
            uniform float2 ui:nodegraph:node:pos = (-238.50081, 7.08313)
        }

        def Shader "color_const" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @nvidia/support_definitions.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "color_const"
            color3f inputs:c.connect = </Root/NodeGraph.inputs:color_const_c>
            color3f outputs:out
            uniform float2 ui:nodegraph:node:pos = (-440.23666, -129.59096)
        }

        def Shader "float3_const" (
            apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            uniform token info:implementationSource = "sourceAsset"
            uniform asset info:mdl:sourceAsset = @nvidia/support_definitions.mdl@
            uniform token info:mdl:sourceAsset:subIdentifier = "float3_const"
            float3 inputs:f3.connect = </Root/NodeGraph.inputs:float3_const_f3>
            float3 outputs:out
            uniform float2 ui:nodegraph:node:pos = (-485.7803, 61.82579)
        }
    }
}

