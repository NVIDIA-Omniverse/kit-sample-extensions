#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 50000)
                double radius = 500
            }
            dictionary Perspective = {
                double3 position = (500, 500, 500)
                double3 target = (-0.00000397803842133726, 0.000007956076785831101, -0.000003978038307650422)
            }
            dictionary Right = {
                double3 position = (-50000, 0, 0)
                double radius = 500
            }
            dictionary Top = {
                double3 position = (0, 50000, 0)
                double radius = 500
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./error.usda"
        }
        dictionary renderSettings = {
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "PreviewSurfaceTexture" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
            customData = {
                dictionary omni = {
                    dictionary ui = {
                        dictionary nodegraph = {
                            dictionary node = {
                                dictionary pos = {
                                    dictionary input = {
                                        float2 mdl = (-135.24052, -73.750015)
                                    }
                                    dictionary output = {
                                        float2 mdl = (-134, 0)
                                        float2 universal = (-130.1373, 0)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        )
        {
            token outputs:displacement.connect = </World/Looks/PreviewSurfaceTexture/UsdPreviewSurface.outputs:displacement>
            token outputs:surface.connect = </World/Looks/PreviewSurfaceTexture/UsdPreviewSurface.outputs:surface>

            def Shader "UsdPreviewSurface" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/PreviewSurfaceTexture/NodeGraph.outputs:out>
                float inputs:metallic.connect = </World/Looks/PreviewSurfaceTexture/error_float.outputs:out>
                token outputs:displacement
                token outputs:surface
                uniform float2 ui:nodegraph:node:pos = (-575.2221, 0)
            }

            def NodeGraph "NodeGraph" (
                customData = {
                    dictionary omni = {
                        dictionary ui = {
                            string[] contextVisibility = ["universal"]
                            dictionary nodegraph = {
                                dictionary node = {
                                    dictionary pos = {
                                        dictionary output = {
                                            float2 universal = (-889.8762, -45.22296)
                                        }
                                        float2 universal = (-1005.60803, 30.765587)
                                    }
                                }
                            }
                        }
                    }
                }
            )
            {
                float3 outputs:out.connect = </World/Looks/PreviewSurfaceTexture/NodeGraph/error_float3.outputs:out>

                def Shader "error_float3" (
                    prepend apiSchemas = ["NodeGraphNodeAPI"]
                )
                {
                    uniform token info:id = "Error"
                    float3 inputs:in = (0.123, 0.456, 0.789)
                    float3 outputs:out
                    uniform float2 ui:nodegraph:node:pos = (-1311.1323, -19.875153)
                }
            }

            def Shader "error_float" (
                prepend apiSchemas = ["NodeGraphNodeAPI"]
            )
            {
                uniform token info:id = "Error"
                float inputs:in = 0.1234
                float outputs:out
                uniform float2 ui:nodegraph:node:pos = (-1317.663, 136.0433)
            }
        }
    }
}



