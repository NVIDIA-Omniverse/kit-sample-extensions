mdl 1.8;

import ::df::*;
import ::state::*;

export material test_material(
    color diffuse_color = color(.8),
    float roughness = 0.0,
    float3 normal = state::normal()
) =
material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::weighted_layer(
            weight: 1.,
            normal: normal,
            layer: df::diffuse_reflection_bsdf(
                    roughness: roughness,
                    tint: diffuse_color
            )
        )
    )
);

export material test_material_2(
    color diffuse_color = color(.6),
    float roughness = 0.5,
    float3 normal = state::normal()
) =
material(
    thin_walled: true,
    surface: material_surface(
        scattering: df::weighted_layer(
            weight: 1.,
            normal: normal,
            layer: df::diffuse_reflection_bsdf(
                    roughness: roughness,
                    tint: diffuse_color
            )
        )
    )
);