    def Xform "Lights"
    {
        def DomeLight "domeLight" (
            prepend apiSchemas = ["ShapingAPI", "ShadowAPI"]
            kind = "model"
        )
        {
            color3f color = (1, 1, 1)
            float colorTemperature = 6500
            float diffuse = 1
            bool enableColorTemperature = 0
            float exposure = 1
            float intensity = 150
            bool normalize = 0
            float specular = 1
            asset texture:file = @./domeLight/photo_studio_01_4k.hdr@
            float3 xformOp:rotateXYZ = (90, 0, 0)
            float3 xformOp:rotateZYX = (0, 0, 0)
            float3 xformOp:scale = (1, 1, 1.0014275)
            uniform token[] xformOpOrder = ["xformOp:rotateZYX"]
        }

