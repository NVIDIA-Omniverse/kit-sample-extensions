#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 50000)
                double radius = 500
            }
            dictionary Perspective = {
                double3 position = (500, 500, 500)
                double3 target = (-0.00000397803842133726, 0.000007956076785831101, -0.00000397803842133726)
            }
            dictionary Right = {
                double3 position = (-50000, 0, 0)
                double radius = 500
            }
            dictionary Top = {
                double3 position = (0, 50000, 0)
                double radius = 500
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        dictionary omni_layer = {
            string authoring_layer = "./timeline_node_test.usda"
            dictionary muteness = {
            }
        }
        dictionary renderSettings = {
            double "rtx:directLighting:sampledLighting:maxRayUnexposedIntensity" = 6399.9990234375
            double "rtx:indirectDiffuse:maxRayUnexposedIntensity" = 6399.9990234375
            double "rtx:pathtracing:fireflyFilter:maxPerEmissiveUnexposedIntensity" = 3199.99951171875
            double "rtx:pathtracing:fireflyFilter:maxUnexposedIntensityPerSample" = 3199.99951171875
            double "rtx:pathtracing:fireflyFilter:maxUnexposedIntensityPerSampleDiffuse" = 3199.99951171875
            double "rtx:raytracing:inscattering:maxRTSampleUnexposedIntensity" = 204799.96875
            double "rtx:translucency:maxRayUnexposedIntensity" = 19199.998046875
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float angle = 1
        float intensity = 3000
        float shaping:cone:angle = 180
        float shaping:cone:softness
        float shaping:focus
        color3f shaping:focusTint
        asset shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def OmniGraph "ActionGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "timeline" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom double inputs:framerate = 120
            custom double inputs:length = 2
            custom bool inputs:loop = 0
            custom double inputs:newTime = 1
            custom uint inputs:play
            prepend uint inputs:play.connect = </World/ActionGraph/on_keyboard_input_03.outputs:released>
            custom uint inputs:playFromStart
            delete uint inputs:playFromStart.connect = </World/ActionGraph/on_keyboard_input_06.outputs:released>
            prepend uint inputs:playFromStart.connect = [
                </World/ActionGraph/on_keyboard_input.outputs:released>,
                </World/ActionGraph/delay.outputs:finished>,
            ]
            custom uint inputs:reverse
            prepend uint inputs:reverse.connect = </World/ActionGraph/on_keyboard_input_04.outputs:released>
            custom uint inputs:reverseFromEnd
            prepend uint inputs:reverseFromEnd.connect = </World/ActionGraph/on_keyboard_input_01.outputs:released>
            custom uint inputs:setNewTime
            prepend uint inputs:setNewTime.connect = </World/ActionGraph/on_keyboard_input_02.outputs:released>
            custom uint inputs:stop
            prepend uint inputs:stop.connect = </World/ActionGraph/on_keyboard_input_05.outputs:released>
            token node:type = "omni.anim.Timeline"
            int node:typeVersion = 2
            custom uint outputs:finished (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:nodeTime
            custom double outputs:output
            uniform int64[] outputs:output:x:inTangentTimes = [0, -94079999]
            uniform token[] outputs:output:x:inTangentTypes = ["auto", "auto"]
            uniform double[] outputs:output:x:inTangentValues = [0, 0]
            uniform int64[] outputs:output:x:outTangentTimes = [94080000, 0]
            uniform token[] outputs:output:x:outTangentTypes = ["auto", "auto"]
            uniform double[] outputs:output:x:outTangentValues = [0, 0]
            uniform bool[] outputs:output:x:tangentBrokens = [0, 0]
            uniform bool[] outputs:output:x:tangentWeighteds = [0, 0]
            uniform int64[] outputs:output:x:times = [0, 282240000]
            uniform double[] outputs:output:x:values = [7.586658057334716e-8, 200.0000017438949]
            custom uint outputs:updated (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"

            def AnimationData "animationData"
            {
            }
        }

