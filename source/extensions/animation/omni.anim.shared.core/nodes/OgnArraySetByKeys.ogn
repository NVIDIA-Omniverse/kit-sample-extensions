{
    "omni.anim.ArraySetByKeys": {
        "version": 1,
        "description":
            "Set values of elements in the original array based on keys. if key is not in the original keys, the value will be ignored. Output array has the same length as the original array.",
        "categories": ["math:array"],
        "scheduling": ["threadsafe"],
        "inputs": {
            "array": {
                "type": ["arrays", "bool[]"],
                "description": "Values to set",
                "metadata": {
                    "uiName": "Array"
                }
            },
            "keys": {
                "type": ["arrays", "token[]"],
                "description": "keys to set",
                "metadata": {
                    "uiName": "Keys"
                }
            },
            "arrayOrig": {
                "type": ["arrays", "bool[]"],
                "description": "The original array values to be modified",
                "metadata": {
                    "uiName": "Array Orig"
                }
            },
            "keysOrig": {
                "type": ["arrays", "token[]"],
                "description": "The original keys",
                "metadata": {
                    "uiName": "Keys Orig"
                }
            }
        },
        "outputs": {
            "array": {
                "type": ["arrays", "bool[]"],
                "description": "Output array",
                "metadata": {
                    "uiName": "Array"
                }
            }
        },
        "tests": [
            {
                "inputs:array": {"type": "int[]", "value": [11, 12]},
                "inputs:arrayOrig": {"type": "int[]", "value": [10, 20, 30, 40, 50]},
                "inputs:keys": {"type": "token[]", "value": ["B", "D"]},
                "inputs:keysOrig": {"type": "token[]", "value": ["A", "B", "C", "D", "E"]},
                "outputs:array": {"type": "int[]", "value": [10, 11, 30, 12, 50]}
            },
            {
                "inputs:array": {"type": "half[]", "value": [11, 12]},
                "inputs:arrayOrig": {"type": "half[]", "value": [10, 20, 30, 40, 50]},
                "inputs:keys": {"type": "token[]", "value": ["B", "D"]},
                "inputs:keysOrig": {"type": "token[]", "value": ["A", "B", "C", "D", "E"]},
                "outputs:array": {"type": "half[]", "value": [10, 11, 30, 12, 50]}
            },
            {
                "inputs:array": {"type": "token[]", "value": ["BOOM", "MEH"]},
                "inputs:arrayOrig": {"type": "token[]", "value": ["READY", "SET", "GO"]},
                "inputs:keys": {"type": "token[]", "value": ["CC", "DD"]},
                "inputs:keysOrig": {"type": "token[]", "value": ["AA", "BB", "CC"]},
                "outputs:array": {"type": "token[]", "value": ["READY", "SET", "BOOM"]}
            },
            {
                "inputs:array": {"type": "half[]", "value": [11, 12]},
                "inputs:arrayOrig": {"type": "half[]", "value": [10, 20, 30, 40, 50]},
                "inputs:keys": {"type": "token[]", "value": ["B", "D"]},
                "inputs:keysOrig": {"type": "token[]", "value": ["D", "B", "C", "D", "E"]},
                "outputs:array": {"type": "half[]", "value": [12, 11, 30, 12, 50]}
            }
        ]
    }
}
