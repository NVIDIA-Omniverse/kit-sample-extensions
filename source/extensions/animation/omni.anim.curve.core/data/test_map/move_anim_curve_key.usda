def Xform "World"
{
    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float angle = 1
        float intensity = 3000
        float shaping:cone:angle = 180
        float shaping:cone:softness
        float shaping:focus
        color3f shaping:focusTint
        asset shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "Cube" (
        prepend apiSchemas = ["AnimationDataAPI"]
    )
    {
        rel animationData:binding = None
        float3[] extent = [(-65, -65, -65), (65, 65, 65)]
        double size = 130
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def AnimationData "animationData"
        {
            uniform int64[] size:x:inTangentTimes = [-39200000]
            uniform token[] size:x:inTangentTypes = ["auto"]
            uniform double[] size:x:inTangentValues = [0]
            uniform int64[] size:x:outTangentTimes = [0]
            uniform token[] size:x:outTangentTypes = ["auto"]
            uniform double[] size:x:outTangentValues = [0]
            uniform bool[] size:x:tangentBrokens = [0]
            uniform bool[] size:x:tangentWeighteds = [0]
            uniform int64[] size:x:times = [117600000]
            uniform double[] size:x:values = [130]
        }
    }

    def Sphere "Sphere" (
        prepend apiSchemas = ["AnimationDataAPI"]
    )
    {
        rel animationData:binding = None
        float3[] extent = [(-50, -50, -50), (50, 50, 50)]
        double radius = 50
        custom bool refinementEnableOverride = 1
        custom int refinementLevel = 2
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (100, 120, -200)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def AnimationData "animationData"
        {
            uniform int64[] xformOp:translate:x:inTangentTimes = [-39200000]
            uniform token[] xformOp:translate:x:inTangentTypes = ["auto"]
            uniform double[] xformOp:translate:x:inTangentValues = [0]
            uniform int64[] xformOp:translate:x:outTangentTimes = [0]
            uniform token[] xformOp:translate:x:outTangentTypes = ["auto"]
            uniform double[] xformOp:translate:x:outTangentValues = [0]
            uniform bool[] xformOp:translate:x:tangentBrokens = [0]
            uniform bool[] xformOp:translate:x:tangentWeighteds = [0]
            uniform int64[] xformOp:translate:x:times = [117600000]
            uniform double[] xformOp:translate:x:values = [100]
            uniform int64[] xformOp:translate:y:inTangentTimes = [-39200000]
            uniform token[] xformOp:translate:y:inTangentTypes = ["auto"]
            uniform double[] xformOp:translate:y:inTangentValues = [0]
            uniform int64[] xformOp:translate:y:outTangentTimes = [0]
            uniform token[] xformOp:translate:y:outTangentTypes = ["auto"]
            uniform double[] xformOp:translate:y:outTangentValues = [0]
            uniform bool[] xformOp:translate:y:tangentBrokens = [0]
            uniform bool[] xformOp:translate:y:tangentWeighteds = [0]
            uniform int64[] xformOp:translate:y:times = [117600000]
            uniform double[] xformOp:translate:y:values = [120]
            uniform int64[] xformOp:translate:z:inTangentTimes = [-39200000]
            uniform token[] xformOp:translate:z:inTangentTypes = ["auto"]
            uniform double[] xformOp:translate:z:inTangentValues = [0]
            uniform int64[] xformOp:translate:z:outTangentTimes = [0]
            uniform token[] xformOp:translate:z:outTangentTypes = ["auto"]
            uniform double[] xformOp:translate:z:outTangentValues = [0]
            uniform bool[] xformOp:translate:z:tangentBrokens = [0]
            uniform bool[] xformOp:translate:z:tangentWeighteds = [0]
            uniform int64[] xformOp:translate:z:times = [117600000]
            uniform double[] xformOp:translate:z:values = [-200]
        }
    }

    def Capsule "Capsule" (
        prepend apiSchemas = ["AnimationDataAPI"]
    )
    {
        rel animationData:binding = None
        uniform token axis = "Y"
        float3[] extent = [(-25, -25, -50), (25, 25, 50)]
        double height = 50
        double radius = 25
        custom bool refinementEnableOverride = 1
        custom int refinementLevel = 2
        double3 xformOp:rotateXYZ = (45, 30, 60)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 200)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def AnimationData "animationData"
        {
            uniform int64[] xformOp:rotateXYZ:x:inTangentTimes = [-39200000]
            uniform token[] xformOp:rotateXYZ:x:inTangentTypes = ["auto"]
            uniform double[] xformOp:rotateXYZ:x:inTangentValues = [0]
            uniform int64[] xformOp:rotateXYZ:x:outTangentTimes = [0]
            uniform token[] xformOp:rotateXYZ:x:outTangentTypes = ["auto"]
            uniform double[] xformOp:rotateXYZ:x:outTangentValues = [0]
            uniform bool[] xformOp:rotateXYZ:x:tangentBrokens = [0]
            uniform bool[] xformOp:rotateXYZ:x:tangentWeighteds = [0]
            uniform int64[] xformOp:rotateXYZ:x:times = [117600000]
            uniform double[] xformOp:rotateXYZ:x:values = [45]
            uniform int64[] xformOp:rotateXYZ:y:inTangentTimes = [-39200000]
            uniform token[] xformOp:rotateXYZ:y:inTangentTypes = ["auto"]
            uniform double[] xformOp:rotateXYZ:y:inTangentValues = [0]
            uniform int64[] xformOp:rotateXYZ:y:outTangentTimes = [0]
            uniform token[] xformOp:rotateXYZ:y:outTangentTypes = ["auto"]
            uniform double[] xformOp:rotateXYZ:y:outTangentValues = [0]
            uniform bool[] xformOp:rotateXYZ:y:tangentBrokens = [0]
            uniform bool[] xformOp:rotateXYZ:y:tangentWeighteds = [0]
            uniform int64[] xformOp:rotateXYZ:y:times = [117600000]
            uniform double[] xformOp:rotateXYZ:y:values = [30]
            uniform int64[] xformOp:rotateXYZ:z:inTangentTimes = [-39200000]
            uniform token[] xformOp:rotateXYZ:z:inTangentTypes = ["auto"]
            uniform double[] xformOp:rotateXYZ:z:inTangentValues = [0]
            uniform int64[] xformOp:rotateXYZ:z:outTangentTimes = [0]
            uniform token[] xformOp:rotateXYZ:z:outTangentTypes = ["auto"]
            uniform double[] xformOp:rotateXYZ:z:outTangentValues = [0]
            uniform bool[] xformOp:rotateXYZ:z:tangentBrokens = [0]
            uniform bool[] xformOp:rotateXYZ:z:tangentWeighteds = [0]
            uniform int64[] xformOp:rotateXYZ:z:times = [117600000]
            uniform double[] xformOp:rotateXYZ:z:values = [60]
        }
    }

    def OmniGraph "PushGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 4)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "CubeCurveNode"
        {
            custom rel inputs:AnimData = </World/Cube/animationData>
            custom string inputs:IndividualOutputs = ""
            custom rel inputs:Prim = </World/Cube>
            custom timecode inputs:Time = 1.79769e+308
            token node:type = "omni.anim.curve.AnimCurve"
            int node:typeVersion = 1

            def Output "outputs_AnimFrame"
            {
            }
        }

        def OmniGraphNode "SphereCurveNode"
        {
            custom rel inputs:AnimData = </World/Sphere/animationData>
            custom string inputs:IndividualOutputs = ""
            custom rel inputs:Prim = </World/Sphere>
            custom timecode inputs:Time = 1.79769e+308
            token node:type = "omni.anim.curve.AnimCurve"
            int node:typeVersion = 1

            def Output "outputs_AnimFrame"
            {
            }
        }

        def OmniGraphNode "CapsuleCurveNode"
        {
            custom rel inputs:AnimData = </World/Capsule/animationData>
            custom string inputs:IndividualOutputs = ""
            custom rel inputs:Prim = </World/Capsule>
            custom timecode inputs:Time = 1.79769e+308
            token node:type = "omni.anim.curve.AnimCurve"
            int node:typeVersion = 1

            def Output "outputs_AnimFrame"
            {
            }
        }
    }
}

