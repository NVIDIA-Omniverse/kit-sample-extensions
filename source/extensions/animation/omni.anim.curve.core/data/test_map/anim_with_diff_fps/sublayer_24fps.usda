    }
    endTimeCode = 100
    metersPerUnit = 0.01
    upAxis = "Y"
)

def "World"
{
    def Cube "Cube"
    {
        float3[] extent = [(-50, -50, -50), (50, 50, 50)]
        double size = 100
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 241.91922252136254)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def AnimationData "animationData"
        {
            uniform int64[] xformOp:translate:x:inTangentTimes = [0, -58799999]
            uniform token[] xformOp:translate:x:inTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:x:inTangentValues = [5.207591140444e-312, 0]
            uniform int64[] xformOp:translate:x:outTangentTimes = [58799999, 0]
            uniform token[] xformOp:translate:x:outTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:x:outTangentValues = [0, 0]
            uniform bool[] xformOp:translate:x:tangentBrokens = [0, 0]
            uniform bool[] xformOp:translate:x:tangentWeighteds = [0, 0]
            uniform int64[] xformOp:translate:x:times = [0, 176400000]
            uniform double[] xformOp:translate:x:values = [0, 613.1987534736953]
        }
    }

    def OmniGraph "CubePushGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 5)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "CubeCurveNode"
        {
            custom rel inputs:AnimData = </World/Cube/animationData>
            custom string inputs:IndividualOutputs = ""
            custom rel inputs:Prim = </World/Cube>
            custom timecode inputs:Time = 1.79769e+308
            token node:type = "omni.anim.curve.AnimCurve"
            int node:typeVersion = 1

            def Output "outputs_AnimFrame"
            {
            }
        }
    }
}
