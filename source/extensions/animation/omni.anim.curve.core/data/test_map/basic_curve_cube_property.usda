    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float angle = 1
        float intensity = 3000
        float shaping:cone:angle = 180
        float shaping:cone:softness
        float shaping:focus
        color3f shaping:focusTint
        asset shaping:ies:file
        double3 xformOp:rotateXYZ = (315, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Cube "Cube" (
        prepend apiSchemas = ["AnimationDataAPI"]
    )
    {
        rel animationData:binding = None
        float3[] extent = [(-50, -50, -50), (50, 50, 50)]
        double size = 100
        double3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:scale = (0.5, 0.5, 0.5)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def AnimationData "animationData"
        {
            uniform int64[] xformOp:scale:x:inTangentTimes = []
            uniform token[] xformOp:scale:x:inTangentTypes = []
            uniform double[] xformOp:scale:x:inTangentValues = []
            uniform int64[] xformOp:scale:x:outTangentTimes = []
            uniform token[] xformOp:scale:x:outTangentTypes = []
            uniform double[] xformOp:scale:x:outTangentValues = []
            uniform bool[] xformOp:scale:x:tangentBrokens = []
            uniform bool[] xformOp:scale:x:tangentWeighteds = []
            uniform int64[] xformOp:scale:x:times = []
            uniform double[] xformOp:scale:x:values = []
            uniform int64[] xformOp:scale:y:inTangentTimes = []
            uniform token[] xformOp:scale:y:inTangentTypes = []
            uniform double[] xformOp:scale:y:inTangentValues = []
            uniform int64[] xformOp:scale:y:outTangentTimes = []
            uniform token[] xformOp:scale:y:outTangentTypes = []
            uniform double[] xformOp:scale:y:outTangentValues = []
            uniform bool[] xformOp:scale:y:tangentBrokens = []
            uniform bool[] xformOp:scale:y:tangentWeighteds = []
            uniform int64[] xformOp:scale:y:times = []
            uniform double[] xformOp:scale:y:values = []
            uniform int64[] xformOp:scale:z:inTangentTimes = []
            uniform token[] xformOp:scale:z:inTangentTypes = []
            uniform double[] xformOp:scale:z:inTangentValues = []
            uniform int64[] xformOp:scale:z:outTangentTimes = []
            uniform token[] xformOp:scale:z:outTangentTypes = []
            uniform double[] xformOp:scale:z:outTangentValues = []
            uniform bool[] xformOp:scale:z:tangentBrokens = []
            uniform bool[] xformOp:scale:z:tangentWeighteds = []
            uniform int64[] xformOp:scale:z:times = []
            uniform double[] xformOp:scale:z:values = []
            uniform int64[] xformOp:translate:x:inTangentTimes = [0, -19600000]
            uniform token[] xformOp:translate:x:inTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:x:inTangentValues = [2.001965123984e-312, 0]
            uniform int64[] xformOp:translate:x:outTangentTimes = [19600000, 0]
            uniform token[] xformOp:translate:x:outTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:x:outTangentValues = [0, 0]
            uniform bool[] xformOp:translate:x:tangentBrokens = [0, 0]
            uniform bool[] xformOp:translate:x:tangentWeighteds = [0, 0]
            uniform int64[] xformOp:translate:x:times = [0, 58800000]
            uniform double[] xformOp:translate:x:values = [0, 166.345]
            uniform int64[] xformOp:translate:y:inTangentTimes = [0, -39200000]
            uniform token[] xformOp:translate:y:inTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:y:inTangentValues = [2.001965123984e-312, 0]
            uniform int64[] xformOp:translate:y:outTangentTimes = [39200000, 0]
            uniform token[] xformOp:translate:y:outTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:y:outTangentValues = [0, 0]
            uniform bool[] xformOp:translate:y:tangentBrokens = [0, 0]
            uniform bool[] xformOp:translate:y:tangentWeighteds = [0, 0]
            uniform int64[] xformOp:translate:y:times = [0, 117600000]
            uniform double[] xformOp:translate:y:values = [0, 70.8288]
            uniform int64[] xformOp:translate:z:inTangentTimes = [0, -58799999]
            uniform token[] xformOp:translate:z:inTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:z:inTangentValues = [2.001965123984e-312, 0]
            uniform int64[] xformOp:translate:z:outTangentTimes = [58799999, 0]
            uniform token[] xformOp:translate:z:outTangentTypes = ["auto", "auto"]
            uniform double[] xformOp:translate:z:outTangentValues = [0, 0]
            uniform bool[] xformOp:translate:z:tangentBrokens = [0, 0]
            uniform bool[] xformOp:translate:z:tangentWeighteds = [0, 0]
            uniform int64[] xformOp:translate:z:times = [0, 176400000]
            uniform double[] xformOp:translate:z:values = [0, 250.701]
        }
    }

    def OmniGraph "PushGraph"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "push"
        token fabricCacheBacking = "Shared"
        int2 fileFormatVersion = (1, 4)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "CubeCurveNode"
        {
            custom rel inputs:AnimData = </World/Cube/animationData>
            custom string inputs:IndividualOutputs = ""
            custom rel inputs:Prim = </World/Cube>
            custom timecode inputs:Time = 1.79769e+308
            token node:type = "omni.anim.curve.AnimCurve"
            int node:typeVersion = 1

            def Output "outputs_AnimFrame"
            {
            }
        }
    }
}

