#usda 1.0
(
    customLayerData = {
        dictionary metricsAssembler = {
            dictionary "/World/cube_physics_cm" = {
                string write_layer = "metrics:root_layer_resolve_0.metricsAssembler"
            }
            int version = 1
        }
    }
    defaultPrim = "World"
    endTimeCode = 100
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @metrics:root_layer_resolve_0.metricsAssembler@
    ]
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "World"
{
    def "cube_physics_cm" (
        instanceable = false
        prepend payload = @./cube_physics_cm.usda@
    )
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:scale:unitsResolve = (0.01, 0.01, 0.01)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale", "xformOp:scale:unitsResolve"]
    }
}
