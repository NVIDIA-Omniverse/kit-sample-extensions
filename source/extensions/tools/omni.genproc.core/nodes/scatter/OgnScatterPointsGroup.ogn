{
    "ScatterPointsGroup": {
        "description": ["Scatters points from grouped sources."],
        "metadata": {
            "uiName": "scatter points group"
        },
        "inputs": {
            "active": {
                "description": "Is the Scatter Points Group node currently active?",
                "type": "bool",
                "default": true,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "bases": {
                "description": "Scatter base meshes.",
                "type": "bundle",
                "optional": true
            },
            "camera": {
                "description": "Camera to filter the scattered points.",
                "type": "bundle",
                "optional": true,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "textures": {
                "description": [ "Textures can be used to filter the scattered points for each bases" ],
                "type": "bundle",
                "optional": true,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "textureFilters": {
                "description": [ "Configuration of texture filters" ],
                "type": "bundle",
                "optional": true
            },
            "curveSources": {
                "description": "Scatter curve sources.",
                "type": "bundle",
                "optional": true,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "curveStepsPerSegment": {
                "description": "Steps per segment for curve tessellation.",
                "type": "uint64",
                "default": 10,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "filterUsingCamera": {
                "description": "If true, the scattered points will be discarded if they are outside the viewing frustum of the provided cameras.",
                "type": "bool",
                "default": false,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "frustumOffset": {
                "description": "Offset to enlarge the frustum filtering the points.",
                "type": "double",
                "default": 0,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "groups": {
                "description": "Scatter groups.",
                "type": "bundle",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "objectIndicesRampPositions": {
                "default": [],
                "description": "Positions over the normalized elevation of the base meshes from 0 to 1.",
                "type": "float[]"
            },
            "objectIndicesRampValues": {
                "default": [],
                "description": "Values of the object indices ramp at the corresponding positions",
                "type": "float[]"
            },
            "objectIndicesRampInterpolations": {
                "default": [],
                "description": [
                    "Interpolation method between keys.",
                    "Linear creates a flat curve from point to point.",
                    "Smooth creates an ease in or ease out curve from point to point."
                ],
                "type": "int[]"
            },
            "objectIndicesRampTags": {
                "default": [],
                "description": "Possible tag values for ramp",
                "type": "token[]"
            },
            "playbackEvaluation": {
                "default": false,
                "description": [ "If this is true, time for the simulation is from the timeline, not real time." ],
                "type": "bool",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "playbackStartFrame": {
                "default": 0,
                "description": [ "If 'playbackEvaluation' is true, this is the frame after which the simulation will start." ],
                "type": "int",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "prototypes": {
                "description": "The Paths of the prototypes.",
                "type": "bundle",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "randomSeed": {
                "default": 0,
                "description": [ "Random seed." ],
                "type": "uint64",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "time": {
                "default": 0,
                "description": [ "Either the running clock or the timeline time or timeline time, depending on playbackEvaluation." ],
                "type": "double",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "usdTimecode": {
                "default": 0,
                "description": [ "The USD timecode at the current playback point (timeline time * timecodes/sec)." ],
                "type": "double",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "volumeSources": {
                "description": "Scatter volume sources.",
                "type": "bundle",
                "optional": true,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "weightsRampPositions": {
                "default": [],
                "description": [ "Positions over the normalized elevation of the base meshes from 0 to 1." ],
                "type": "float[]"
            },
            "weightsRampValues": {
                "default": [],
                "description": [ "Values of the weights ramp at the corresponding positions" ],
                "type": "float[]"
            },
            "weightsRampInterpolations": {
                "default": [],
                "description": [
                    "Interpolation method between keys.",
                    "Linear creates a flat curve from point to point.",
                    "Smooth creates an ease in or ease out curve from point to point."
                ],
                "type": "int[]"
            }
        },
        "outputs": {
            "bundle": {
                "description": [ "output bundle of points data" ],
                    "type": "bundle"
            }
        },
        "state": {
            "prevActive": {
                "description": "Previous active value for recompute test",
                "type": "bool"
            },
            "prevCurveStepsPerSegment": {
                "description": "Previous curve steps per segment value for recompute test",
                "type": "uint64"
            },
            "prevFilterUsingCamera": {
                "description": "Previous filter using camera value for recompute test",
                "type": "bool"
            },
            "prevFrustumOffset": {
                "description": "Previous frustum offset value for recompute test",
                "type": "double"
            },
            "prevObjectIndicesRampPositions": {
                "description": "Previous object indices ramp positions values for recompute test",
                "type": "float[]"
            },
            "prevObjectIndicesRampValues": {
                "description": "Previous object indices ramp values for recompute test",
                "type": "float[]"
            },
            "prevObjectIndicesRampInterpolations": {
                "description": "Previous object indices ramp interpolations for recompute test",
                "type": "int[]"
            },
            "prevPlaybackEvaluation": {
                "description": "Previous playbackEvaluation value for recompute test",
                "type": "bool"
            },
            "prevPlaybackStartFrame": {
                "description": "Previous playbackStartFrame value for recompute test",
                "type": "int"
            },
            "prevRandomSeed": {
                "description": "Previous randomSeed value for recompute test",
                "type": "uint64"
            },
            "prevTime": {
                "description": "Previous time value for recompute test",
                "type": "double"
            },
            "prevUsdTimecode": {
                "description": "Previous usdTimecode value for recompute test",
                "type": "double"
            },
            "prevWeightsRampPositions": {
                "description": "Previous weights ramp positions values for recompute test",
                "type": "float[]"
            },
            "prevWeightsRampValues": {
                "description": "Previous weights ramp values for recompute test",
                "type": "float[]"
            },
            "prevWeightsRampInterpolations": {
                "description": "Previous weights ramp interpolations for recompute test",
                "type": "int[]"
            },
            "cachedCurveSources": {
                "description": "Cached curve sources",
                "type": "bundle"
            },
            "cachedBaseMeshes": {
                "description": "Cached base meshes",
                "type": "bundle"
            },
            "cachedVolumeSources": {
                "description": "Cached volume sources",
                "type": "bundle"
            }
        },
        "tokens": {
            "additive": "additive",
            "basis": "basis",
            "bezier": "bezier",
            "binormals": "binormals",
            "bspline": "bspline",
            "catmullRom": "catmullRom",
            "curveVertexCounts": "curveVertexCounts",
            "curvePathRegion": "curvePathRegion",
            "curvePathWidth": "curvePathWidth",
            "curvePathWidthRampPositions": "curvePathWidthRampPositions",
            "curvePathWidthRampValues": "curvePathWidthRampValues",
            "curvePathWidthRampInterpolations": "curvePathWidthRampInterpolations",
            "curvePathWidthTags": "curvePathWidthTags",
            "density": "density",
            "desiredPoints": "desiredPoints",
            "dirtyID": "dirtyID",
            "filteredTris": "filteredTris",
            "groupName": "groupName",
            "noiseModulation": "noiseModulation",
            "noiseExponential": "noiseExponential",
            "nonperiodic": "nonperiodic",
            "normals": "normals",
            "normalUpVectorBias": "normalUpVectorBias",
            "objectIndex": "objectIndex",
            "objectIndices": "objectIndices",
            "offset": "offset",
            "offsetRandom": "offsetRandom",
            "primvars_objectIndices": "primvars:objectIndices",
            "periodic": "periodic",
            "pinned": "pinned",
            "points": "points",
            "primvars_scatterWeights": "primvars:scatterWeights",
            "prototypes": "prototypes",
            "prototypePercents": "prototypePercents",
            "pruneCollision": "pruneCollision",
            "randomSeed": "randomSeed",
            "rotation": "rotation",
            "rotationRandom": "rotationRandom",
            "rotations": "rotations",
            "scale": "scale",
            "scaleRandom": "scaleRandom",
            "scales": "scales",
            "scatterMethod": "scatterMethod",
            "scatterWeights": "scatterWeights",
            "settingsOverride": "settingsOverride",
            "subtractive": "subtractive",
            "slopeMask": "slopeMask",
            "tangents": "tangents",
            "transform": "transform",
            "triIndices": "triIndices",
            "visible": "visible",
            "wrap": "wrap",
            "zoneSign": "zoneSign",
            "BasisCurves": "BasisCurves",
            "Mesh": "Mesh",
            "width": "width",
            "height": "height",
            "bitDepth": "bitDepth",
            "componentCount": "componentCount",
            "valid": "valid",
            "data": "data",
            "baseIndex": "baseIndex",
            "channel": "channel",
            "textureIndex": "textureIndex",
            "r": "r",
            "g": "g",
            "b": "b",
            "a": "a"
        }
    }
}
