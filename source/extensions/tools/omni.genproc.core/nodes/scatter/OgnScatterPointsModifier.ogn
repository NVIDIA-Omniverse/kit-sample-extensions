{
    "ScatterPointsModifier": {
        "description": ["Post-modifier node for scatter points."],
        "metadata": {
            "uiName": "scatter points modifier"
        },
        "inputs": {
            "active": {
                "description": "Is the Scatter Points Group node currently active?",
                "type": "bool",
                "default": true,
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "bundle": {
                "description": [ "input bundle of points data" ],
                "type": "bundle"
            },
            "ids": {
                "default": [],
                "description": [
                    "Ids of points to be modified"
                ],
                "type": "int[]"
            },
            "positions": {
                "default": [],
                "description": [
                    "Positions of points to be modified"
                ],
                "type": "float[3][]"
            },
            "rotations": {
                "default": [],
                "description": [
                    "Rotations of points to be modified"
                ],
                "type": "float[3][]"
            },
            "scales": {
                "default": [],
                "description": [
                    "Scales of points to be modified"
                ],
                "type": "float[3][]"
            },
            "tangents": {
                "default": [],
                "description": [
                    "Tangents of points to be modified"
                ],
                "type": "float[3][]"
            },
            "normals": {
                "default": [],
                "description": [
                    "Normals of points to be modified"
                ],
                "type": "float[3][]"
            },
            "objectIndices": {
                "default": [],
                "description": [
                    "Object Indices of points to be modified"
                ],
                "type": "int[]"
            }
        },
        "outputs": {
            "bundle": {
                "description": [ "output bundle of points data" ],
                "type": "bundle"
            }
        },
        "state": {
            "prevActive": {
                "description": "Previous active value for recompute test",
                "type": "bool"
            },
            "prevIds": {
                "default": [],
                "description": [
                    "Previous ids of points to be modified"
                ],
                "type": "int[]"
            },
            "prevPositions": {
                "default": [],
                "description": [
                    "Previous positions of points to be modified"
                ],
                "type": "float[3][]"
            },
            "prevRotations": {
                "default": [],
                "description": [
                    "Previous rotations of points to be modified"
                ],
                "type": "float[3][]"
            },
            "prevScales": {
                "default": [],
                "description": [
                    "Previous scales of points to be modified"
                ],
                "type": "float[3][]"
            },
            "prevTangents": {
                "default": [],
                "description": [
                    "Previous tangents of points to be modified"
                ],
                "type": "float[3][]"
            },
            "prevNormals": {
                "default": [],
                "description": [
                    "Previous normals of points to be modified"
                ],
                "type": "float[3][]"
            },
            "prevObjectIndices": {
                "default": [],
                "description": [
                    "Previous object indices of points to be modified"
                ],
                "type": "int[]"
            },
            "remappedIdsFrom": {
                "description": "Remapped ids from",
                "type": "int[]"
            },
            "remappedIdsTo": {
                "description": "Remapped ids to",
                "type": "int[]"
            }
        },
        "tokens": {
            "points": "points",
            "rotations": "rotations",
            "scales": "scales",
            "tangents": "tangents",
            "normals": "normals",
            "objectIndices": "objectIndices"
        }
    }
}
