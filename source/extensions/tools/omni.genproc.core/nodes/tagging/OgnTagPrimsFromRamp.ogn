{
    "TagPrimsFromRamp": {
        "categories": "tagging",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Add ramp and tag information to a bundle of prims. This data can be subsequently sampled in downstream nodes ",
                        "(e.g. GetCurveData in the case of curve prims)"],
        "uiName": "Tag Prims from Ramp",
        "inputs": {
            "bundle": {
                "type": "bundle",
                "description": "Bundle Prims",
                "uiName": "Bundle"
            },
            "rampPositionsName": {
                "type": "token",
                "default": "ramp_positions",
                "description": "Name of bundle attribute to be created for ramp positions.",
                "uiName": "Ramp Positions Name"
            },
            "rampValuesName": {
                "type": "token",
                "default": "ramp_values",
                "description": "Name of bundle attribute to be created for ramp values.",
                "uiName": "Ramp Values Name"
            },
            "rampInterpolationsName": {
                "type": "token",
                "default": "ramp_interpolations",
                "description": "Name of bundle attribute to be created for ramp interpolations.",
                "uiName": "Ramp Interpolations Name"
            },
            "rampTagsName": {
                "type": "token",
                "default": "tags",
                "description": "Name of bundle attribute to be created for ramp tags.",
                "uiName": "Ramp Tags Name"
            },
            "rampPositions": {
                "default": [0.0, 1.0],
                "description": ["Parametetric values from [0,1]"],
                "type": "float[]"
            },
            "rampValues": {
                "default": [0.0, 0.0],
                "description": ["Value of the ramp at the corresponding position entry."],
                "type": "float[]"
            },
            "rampInterpolations": {
                "default": [1, 1],
                "description": ["Interpolation method between keys.",
                                "Linear is a creates a flat curve from point to point.", 
                                "Smooth creates an ease in or ease out curve from point to point." ],
                "type": "int[]"
            },
            "rampTags": {
                "default": ["run", "walk", "idle"],
                "description": "Possible tag values for ramp",
                "type": "token[]"
            }
        },
        "outputs": {
            "bundle": {
                "description": "Prims bundle with ramp data",
                "type": "bundle"
            }
        },
        "state": {
            "prevRampPositionsName": {
                "description": ["Previous rampPositionsName value for recompute test"],
                "type": "token"
            },
            "prevRampValuesName": {
                "description": ["Previous rampValuesName value for recompute test"],
                "type": "token"
            },
            "prevRampInterpolationsName": {
                "description": ["Previous rampInterpolationsName value for recompute test"],
                "type": "token"
            },
            "prevRampTagsName": {
                "description": ["Previous rampTagsName value for recompute test"],
                "type": "token"
            },
            "prevRampPositions": {
                "description": ["Previous rampPositions values for recompute test"],
                "type": "float[]"
            },
            "prevRampValues": {
                "description": ["Previous rampValues values for recompute test"],
                "type": "float[]"
            },
            "prevRampInterpolations": {
                "description": ["Previous rampInterpolations values for recompute test"],
                "type": "int[]"
            },
            "prevRampTags": {
                "description": ["Previous rampTags values for recompute test"],
                "type": "token[]"
            }
        },
        "version": 1
    }
}
