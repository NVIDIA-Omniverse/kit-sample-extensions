{
    "ClosestPointOnCurve": {
        "categories": "curve",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Given a reference point and a bundle containing curve data, get the closest point on the curve to ",
                        "the reference point along with the curve tangent and u-value (between zero and one) at that point. ",
                        "Note that if multiple curves are present in the bundle, only the first one will be used."],
        "uiName": "Closest Point on Curve",
        "inputs": {
            "curvesBundle": {
                "type": "bundle",
                "description": "Bundle containing curves data",
                "uiName": "Curves Bundle"
            },
            "point": {
                "type": "float[3]",
                "description": "Reference point for which we want to find the closest point on the input curve(s)",
                "uiName": "Point"
            }
        },
        "outputs": {
            "point": {
                "type": "float[3]",
                "description": "Closest point on input curve(s) to specified reference point",
                "uiName": "Point on Curve"
            },
            "tangent": {
                "type": "float[3]",
                "description": "Curve tangent at closest point on curve",
                "uiName": "Tangent at Point"
            },
            "uValue": {
                "type": "float",
                "description": "Parametric value of closest pont on curve",
                "uiName": "U Value"
            }
        },
        "state": {
            "cacheBundle": {
                "description": "cached compute state",
                "type": "bundle"
            },
            "prevPoint": {
                "description": ["Previous point value for recompute test"],
                "type": "float[3]"
            }
        },
        "tokens": {
            "points": "points",
            "curveVertexCounts": "curveVertexCounts",
            "basis": "basis",
            "bezier": "bezier",
            "bspline": "bspline",
            "catmullRom": "catmullRom",
            "wrap": "wrap",
            "pinned": "pinned",
            "periodic": "periodic",
            "nonperiodic": "nonperiodic",
            "type": "type",
            "cubic": "cubic",
            "linear": "linear",
            "transform": "transform",
            "tangents": "tangents",
            "distances": "distances",
            "curveSegmentCounts": "curveSegmentCounts"
        },
        "version": 1
    }
}
