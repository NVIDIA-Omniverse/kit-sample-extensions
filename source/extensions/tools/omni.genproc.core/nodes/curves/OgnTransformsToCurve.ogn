{
    "TransformsToCurve": {
        "categories": "curve",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Given a bundle of prims, use the transforms of those prims to create a spline curve."],
        "uiName": "Transforms to Curve",
        "inputs": {
            "transformBundle": {
                "type": "bundle",
                "description": "Bundle containing transform data",
                "uiName": "Transform Bundle"
            },
            "basis": {
                "type": "int",
                "default": 0,
                "description": ["Curve basis (0 - Bezier, 1 - BSpline, 2 - Catmull-Rom)"],
                "minimum": 0,
                "maximum": 2,
                "uiName": "Basis",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "wrap": {
                "type": "int",
                "default": 0,
                "description": "Curve wrap setting (0 - nonperiodic, 1 - periodic, 2 - pinned)",
                "minimum": 0,
                "maximum": 2,
                "uiName": "Wrap",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "type": {
                "type": "int",
                "default": 1,
                "description": "Curve type (0 - linear, 1 - cubic)",
                "minimum": 0,
                "maximum": 1,
                "uiName": "Type",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "tangentLength": {
                "description": "Scale factor applied to curve tangents (note that tangents are also scaled by the scale of the transformable prims in the transform bundle)",
                "type": "float",
                "default": 1.0,
                "uiName": "Tangent Length",
                "metadata": {
                    "displayGroup": "parameters"
                }
            }
        },
        "outputs": {
            "curveBundle": {
                "type": "bundle",
                "description": "Bundle containing curves data",
                "uiName": "Curve Bundle"
            }
        },
        "state": {
            "prevBasis": {
                "description": ["Previous basis value for recompute test"],
                "type": "int"
            },
            "prevWrap": {
                "description": ["Previous wrap value for recompute test"],
                "type": "int"
            },
            "prevType": {
                "description": ["Previous type value for recompute test"],
                "type": "int"
            },
            "prevTangentLength": {
                "description": ["Previous tangentLength value for recompute test"],
                "type": "float"
            }
        },
        "tokens": {
            "points": "points",
            "curveVertexCounts": "curveVertexCounts",
            "basis": "basis",
            "bezier": "bezier",
            "bspline": "bspline",
            "catmullRom": "catmullRom",
            "wrap": "wrap",
            "pinned": "pinned",
            "periodic": "periodic",
            "nonperiodic": "nonperiodic",
            "type": "type",
            "cubic": "cubic",
            "linear": "linear",
            "travelling": "travelling"
        },
        "version": 1
    }
}
