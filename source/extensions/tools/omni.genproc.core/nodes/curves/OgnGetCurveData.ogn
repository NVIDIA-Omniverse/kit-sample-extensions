{
    "GetCurveData": {
        "categories": "curve",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Extract curve data from the first curve found in the input bundle. ",
                        "If the input bundle contains ramp and tag data, e.g. from an upstream TagPrimsFromRamp ",
                        "node, the ramp will be evaluated and used to add a tag corresponding to each point."],
        "uiName": "Get Curve Data",
        "inputs": {
            "curvesBundle": {
                "type": "bundle",
                "description": "Bundle containing curves data",
                "uiName": "Curves Bundle"
            },
            "samplesPerSegment": {
                "type": "int",
                "default": 100,
                "description": "Number of points in each curve segment's tessellation",
                "uiName": "Samples per Segment"
            },
            "rampPositionsName": {
                "type": "token",
                "default": "ramp_positions",
                "description": ["Name of bundle attribute containing ramp positions. ",
                                "If no such attribute exists, the tags output will be empty."],
                "uiName": "Ramp Positions Name"
            },
            "rampValuesName": {
                "type": "token",
                "default": "ramp_values",
                "description": ["Name of bundle attribute containing ramp values. ",
                                "If no such attribute exists, the tags output will be empty."],
                "uiName": "Ramp Values Name"
            },
            "rampInterpolationsName": {
                "type": "token",
                "default": "ramp_interpolations",
                "description": ["Name of bundle attribute containing ramp interpolations. ",
                                "If no such attribute exists, the tags output will be empty."],
                "uiName": "Ramp Interpolations Name"
            },
            "rampTagsName": {
                "type": "token",
                "default": "tags",
                "description": ["Name of bundle attribute containing ramp tags. ",
                                "If no such attribute exists, the tags output will be empty."],
                "uiName": "Ramp Tags Name"
            }
        },
        "outputs": {
            "points": {
                "type": "float[3][]",
                "description": "Vertices along the curve",
                "uiName": "Points"
            },
            "tangents": {
                "type": "float[3][]",
                "description": "Curve tangents at each vertex",
                "uiName": "Tangents"
            },
            "uValues": {
                "type": "float[]",
                "description": "Parametric value from zero to one along the curve for each vertex",
                "uiName": "U Values"
            },
            "tags": {
                "type": "token[]",
                "description": "Per-point tag value, provided only if valid ramp data is provided in the input bundle",
                "uiName": "Tags"
            }
        },
        "state": {
            "prevSamplesPerSegment": {
                "description": ["Previous samplesPerSegment value for recompute test"],
                "type": "int"
            },
            "prevRampPositionsName": {
                "description": ["Previous rampPositionsName value for recompute test"],
                "type": "token"
            },
            "prevRampValuesName": {
                "description": ["Previous rampValuesName value for recompute test"],
                "type": "token"
            },
            "prevRampInterpolationsName": {
                "description": ["Previous rampInterpolationsName value for recompute test"],
                "type": "token"
            },
            "prevRampTagsName": {
                "description": ["Previous rampTagsName value for recompute test"],
                "type": "token"
            }
        },
        "tokens": {
            "points": "points",
            "curveVertexCounts": "curveVertexCounts",
            "basis": "basis",
            "bezier": "bezier",
            "bspline": "bspline",
            "catmullRom": "catmullRom",
            "wrap": "wrap",
            "pinned": "pinned",
            "periodic": "periodic",
            "nonperiodic": "nonperiodic",
            "type": "type",
            "cubic": "cubic",
            "linear": "linear",
            "transform": "transform"
        },
        "version": 1
    }
}
