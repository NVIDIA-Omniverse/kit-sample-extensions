{
    "PushoutCurvePoints": {
        "categories": "curve",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Sample points along curves in the input curvesBundle. When a range of these points falls within the ",
                        "bounding sphere / box of the prims within the collisionBundle, this node attempts to push those subsections ",
                        "of points outside the bounding volume in some reasonable way. ",
                        "This node outputs two bundles: a pointsBundle that contains one prim per polyline containing the ",
                        "displaced points of that polyline, and a curvesBundle that contains curve prims fit to those ",
                        "displaced points."],
        "inputs": {
            "curvesBundle": {
                "type": "bundle",
                "description": "Bundle containing curves data",
                "uiName": "Transform Bundle"
            },
            "samplesPerSegment": {
                "type": "int",
                "default": 20,
                "description": "Number of points in each curve segment's tessellation",
                "uiName": "Samples per Segment"
            },
            "collisionBundle": {
                "type": "bundle",
                "description": "Input meshes. The bounding spheres / boxes of each of these meshes will be used as the pushout volumes.",
                "uiName": "Transform Bundle"
            },
            "collisionProxy": {
                "type": "int",
                "description": ["0 = Sphere, 1 = Axis-Oriented Box"],
                "default": 0,
                "minimum": 0,
                "maximum": 1,
                "uiName": "Collision Proxy"
            },
            "pushoutHorizontally": {
                "type": "bool",
                "default": false,
                "description": ["If true, pushout will not modify any particle's vertical position (as defined by the specified up vector)"],
                "uiName": "Push Out Horizontally"
            },
            "upAxisSource": {
                "type": "int",
                "description": ["0 = Use Scene Up, 1 = Use Node UpAxis"],
                "default": 0,
                "minimum": 0,
                "maximum": 1,
                "uiName": "Up Axis Source"
            },
            "upAxis": {
                "description": "Up axis to be used when 'Node UpAxis' is specified as the up axis source.",
                "type": "float[3]",
                "default": [0, 1, 0],
                "uiName": "Up Axis"
            },
            "numberOfSegments": {
                "description": ["Number of segments per curve for each output curve. If this value is not positive, ",
                               "the number of segments in the corresponding input curve will be used."],
                "type": "int",
                "default": 0,
                "uiName": "Number of Segments"
            }
        },
        "outputs": {
            "pointsBundle": {
                "type": "bundle",
                "description": "Bundle containing displaced points data sampled from curves",
                "uiName": "Points Bundle"
            },
            "curvesBundle": {
                "type": "bundle",
                "description": "Bundle containing curves fit to displaced points",
                "uiName": "Transform Bundle"
            }
        },
        "state": {
            "prevSamplesPerSegment": {
                "description": ["Previous samplesPerSegment value for recompute test"],
                "type": "int"
            },
            "prevCollisionProxy": {
                "description": ["Previous collisionProxy value for recompute test"],
                "type": "int"
            },
            "prevPushoutHorizontally": {
                "description": ["Previous pushoutHorizontally value for recompute test"],
                "type": "bool"
            },
            "prevUpAxisSource": {
                "description": ["Previous upAxisSource value for recompute test"],
                "type": "int"
            },
            "prevUpAxis": {
                "description": ["Previous upAxis value for recompute test"],
                "type": "float[3]"
            },
            "prevNumberOfSegments": {
                "description": ["Previous numberOfSegments value for recompute test"],
                "type": "int"
            }
        },
        "tokens": {
            "points": "points",
            "curveVertexCounts": "curveVertexCounts",
            "basis": "basis",
            "bezier": "bezier",
            "bspline": "bspline",
            "catmullRom": "catmullRom",
            "wrap": "wrap",
            "pinned": "pinned",
            "periodic": "periodic",
            "nonperiodic": "nonperiodic",
            "type": "type",
            "cubic": "cubic",
            "linear": "linear",
            "transform": "transform"
        },
        "metadata": {
            "uiName": "curves: pushout curve points"
        },
        "version": 1
    }
}
