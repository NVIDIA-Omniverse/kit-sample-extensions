{
    "PointsOnCurve": {
        "categories": "curve",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Given a bundle containing curve data and a u-value (between zero and one), ",
                        "get a point on the curve and the curve tangent at that point. ",
                        "Note that if multiple curves are present in the bundle, only the first one will be used."],
        "inputs": {
            "curvesBundle": {
                "type": "bundle",
                "description": "Bundle containing curves data",
                "uiName": "Curves Bundle"
            },
            "uValues": {
                "type": "float[]",
                "description": ["Parametric values from zero to one at which to sample points on the curve"],
                "uiName": "U-Values",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "samplingMode": {
                "type": "int",
                "default": 0,
                "description": ["Sampling mode: 0 -- sample from an input array connect to the uValues input, 1 -- sample from a random distribution generated using the timeBasedSeed, randomSeed, and numberOfPoints inputs"],
                "uiName": "Sampling Mode",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "timeBasedSeed": {
                "type": "bool",
                "default": false,
                "description": ["If true, random seed will vary with time; if false random numbers will be the same each frame."],
                "uiName": "Vary Randomness Over Time",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "randomSeed": {
                "type": "int",
                "default": 0,
                "description": ["Seed for random number generator for u-value distribution (if nothing is connected to the uValue input)"],
                "uiName": "Random Seed",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "numberOfPoints": {
                "type": "int",
                "default": 10,
                "description": ["Number of points to randomly sample on the curve (if nothing is connected to the uValue input)"],
                "uiName": "Number of Points",
                "metadata": {
                    "displayGroup": "parameters"
                }
            }
        },
        "outputs": {
            "points": {
                "type": "float[3][]",
                "description": "Point on input curve",
                "uiName": "Point on Curve"
            },
            "tangents": {
                "type": "float[3][]",
                "description": "Curve tangent at point",
                "uiName": "Tangent at Point"
            }
        },
        "state": {
            "prevUValues": {
                "description": ["Previous uValues value for recompute test"],
                "type": "float[]"
            },
            "prevSamplingMode": {
                "description": ["Previous samplingMode value for recompute test"],
                "type": "int"
            },
            "prevTimeBasedSeed": {
                "description": ["Previous timeBasedSeed value for recompute test"],
                "type": "bool"
            },
            "prevRandomSeed": {
                "description": ["Previous randomSeed value for recompute test"],
                "type": "int"
            },
            "prevNumberOfPoints": {
                "description": ["Previous numberOfPoints value for recompute test"],
                "type": "int"
            }
        },
        "metadata": {
            "uiName": "Points on Curve"
        },
        "version": 1
    }
}
