{
    "OrderMatricesByDistance": {
        "categories": "spatial",
        "categoryDefinitions": "../../config/CurveCategories.json",
        "description": ["Order matrices based on the distance from their translation component to a reference point."],
        "uiName": "Order Matrices by Distance",
        "inputs": {
            "point": {
                "type": "float[3]",
                "default": [0, 0, 0],
                "description": "Reference point from which distances to matrices are measured.",
                "uiName": "Reference Point"
            },
            "matrices": {
                "type": "matrixd[4][]",
                "description": "Matrices to be sorted according to the distance from their translation component to the reference point",
                "uiName": "Matrices"
            }
        },
        "outputs": {
            "matrices": {
                "type": "matrixd[4][]",
                "description": "Sorted list of matrices",
                "uiName": "Ordered Matrices"
            }
        },
        "state": {
            "prevPoint": {
                "description": ["Previous point value for recompute test"],
                "type": "float[3]"
            },
            "prevMatrices": {
                "description": ["Previous matrices value for recompute test"],
                "type": "matrixd[4][]"
            }
        },
        "version": 1
    }
}
