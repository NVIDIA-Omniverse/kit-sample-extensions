{
    "Generate3dText":{
        "version": 1,
        "description": [
            "Generates 3D text on stage by instancing letter meshes.\n",
            "inputs:fontPrim should be the parent prim of the letter meshes used for this node.\n",
            "Letter mesh prim names should follow the naming convention of alpha_{char} where char is a",
            "single case-sensitive letter to be matched in the given text, or chr_{num} where num is",
            "an integer which corresponds to a unicode code point, to be matched in the given text.\n",
            "For example 'alpha_w' matches 'w', and 'chr_36' matches '$'.\n",
            "It is recommended that the fontPrim is an 'over' so that the prototypes will not be included",
            "in normal stage traversal."
        ],
        "language": "python",
        "uiName": "Generate 3D Text",
        "scheduling": ["usd-write"],
        "exclude": ["tests"],
        "metadata": {"hidden": "true"},
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "The execution input",
                "uiName": "In"
            },
            "text": {
                "type": "string",
                "description": "The text to be displayed on stage",
                "uiName": "Text"
            },
            "scale": {
                "type": "float",
                "description": "The scale of letters shown",
                "uiName": "Scale",
                "default": 1.0
            },
            "fontPrim": {
                "type": "target",
                "description": "The parent Prim of the letter meshes",
                "uiName":"Font Prim"
            },
            "instancerPrim": {
                "type": "target",
                "description": "The instancer prim to be used for the generated text",
                "uiName":"PointInstancer Prim"
            },
            "characterSpacing": {
                "type": "float",
                "description": "The relative spacing between letters",
                "uiName": "Character Spacing",
                "default": 65.0
            },
            "alignment": {
                "type": "token",
                "description": "Alignment style",
                "default": "Left",
                "uiName": "Alignment",
                "metadata": {
                    "allowedTokens": [
                        "Left",
                        "Center",
                        "Right"
                    ]
                }
            }
        },
        "outputs": {
            "execOut": {
                "type": "execution",
                "description": "The execution output",
                "uiName": "Out"
            }
        }
    }
}
