        dictionary cameraSettings = {
            dictionary Front = {
                double3 position = (0, 0, 50000)
                double radius = 500
            }
            dictionary Perspective = {
                double3 position = (720.1681105415705, 281.6596967740733, 461.38904621322007)
                double3 target = (-223.17479125776777, -33.50827156151519, -343.55148739560997)
            }
            dictionary Right = {
                double3 position = (-50000, 0, -1.1102230246251565e-11)
