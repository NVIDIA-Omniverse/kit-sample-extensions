{
    "TriMeshVisualizer": {
        "description": ["Display Triangle Mesh"],
        "inputs": {
            "active": {
                "default": true,
                "description": ["Display point"],
                "type": "bool",
                "metadata": {
                    "displayGroup": "parameters"
                }
            },
            "primBundle": {
                "type": "bundle",
                "description": "Bundle containing prim data",
                "$optional": true,
                "uiName": "Prim in Bundle"
            },
            "boldFace": {
                "type": "int",
                "default": -1,
                "description": "foobar",
                "uiName": "Bold Face"
            },
            "verbose": {
                "type": "bool",
                "default": false,
                "description": "foobar",
                "uiName": "Verbose"
            }
        },
        "metadata": {
            "uiName": "scene visualization: tri mesh visualizer"
        },
        "tokens": {
            "points": "points",
            "transform": "transform"
        },
        "version": 1
    }
}
