#usda 1.0
(
    defaultPrim = "World"
    """
    This USD presents materials with invalid 'inputs:nonvisual:attributes' - incorrect valud, incorrect type, not defined
    """
)

def Xform "World"
{
    def Cube "Cube_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_attributes_labels>
    }

    def Cube "Cube_06" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_attributes_label>
    }

    def Cube "Cube_02" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_attributes_type>
    }

    def Cube "Cube_03" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_attributes_not_defined>
    }

    def Cube "Cube_04" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_attributes_time_samples>
    }

    def Cube "Cube_05" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_attributes_type_string>
    }

    def Scope "Looks"
    {
        def Material "invalid_attributes_labels"
        {
            token omni:simready:nonvisual:base = "aluminum"
            token omni:simready:nonvisual:coating = "clearcoat"
            token[] omni:simready:nonvisual:attributes = ["something", "else", "emissive"]
        }

        def Material "invalid_attributes_label"
        {
            token omni:simready:nonvisual:base = "aluminum"
            token omni:simready:nonvisual:coating = "clearcoat"
            token[] omni:simready:nonvisual:attributes = ["something"]
        }

        def Material "invalid_attributes_type"
        {
            token omni:simready:nonvisual:base = "aluminum"
            token omni:simready:nonvisual:coating = "clearcoat"
            token omni:simready:nonvisual:attributes = "something"
        }

        def Material "invalid_attributes_not_defined"
        {
            token omni:simready:nonvisual:base = "aluminum"
            token omni:simready:nonvisual:coating = "clearcoat"
        }

        def Material "invalid_attributes_time_samples"
        {
            token omni:simready:nonvisual:base.timeSamples = {1 : "aluminum"}
            token[] omni:simready:nonvisual:attributes = []
            token omni:simready:nonvisual:coating = "clearcoat"
        }
        def Material "invalid_attributes_type_string"
        {
            token omni:simready:nonvisual:base = "aluminum"
            token omni:simready:nonvisual:coating = "clearcoat"
            string[] omni:simready:nonvisual:attributes = ["emissive"]
        }
    }
}
