#usda 1.0
(
    defaultPrim = "World"
    """
    This USD presents gprims without valid material bindings.
    - No material binding
    - Only has preview binding
    """
)

def Xform "World"
{
    def Cube "no_material" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
    }

    def Mesh "preview" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:preview = </World/Looks/valid_material>
    }

    def Scope "Looks"
    {
        def Material "valid_material"
        {
            token outputs:mdl:surface.connect = </World/Looks/valid_material/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR"
                token outputs:out
            }
        }
    }
}
