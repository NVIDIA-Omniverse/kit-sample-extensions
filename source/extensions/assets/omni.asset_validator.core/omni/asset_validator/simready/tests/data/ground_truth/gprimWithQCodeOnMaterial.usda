#usda 1.0
(
    defaultPrim = "World"

    """
    This USD presents a gprim with qcode authored to its bound material.
    """
)

def Xform "World" (
)
{
    def Material "material" (
        prepend apiSchemas = ["SemanticsLabelsAPI:wikidata_qcode"]
    )
    {
        token[] semantics:labels:wikidata_qcode = ["Q12345"]
    }

    def Cube "Cube"
    {
        rel material:binding = </World/material>
    }
}
