#usda 1.0
(
    defaultPrim = "World"
    """
    This USD presents invalid surface shaders of materials.
    - Shader is not a UsdPreviewSurface nor a MDL shader.
    - Material has no surface shader connected.
    """
)

def Xform "World"
{
    def Cube "cube_invalid_surface_shader" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_shader>
    }

    def Cube "cube_no_surface_shader" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/no_surface_shader>
    }

    def Cube "cube_ups_shader_in_mdl_render_context" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/ups_shader_in_mdl_render_context>
    }

    def Scope "Looks"
    {
        def Material "invalid_shader"
        {
            token outputs:mdl:surface.connect = </World/Looks/invalid_shader/mtlx.outputs:out>
            def Shader "mtlx"
            {
                uniform token info:id = "ND_standard_surface_surfaceshader"
                token outputs:out
            }
        }

        def Material "no_surface_shader"
        {
        }

        def Material "ups_shader_in_mdl_render_context"
        {
            token outputs:mdl:surface.connect = </World/Looks/ups_shader_in_mdl_render_context/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface
            }
        }
    }
}
