#usda 1.0
(
    defaultPrim = "World"
    """
    This USD presents valid surface shaders of materials. The shader type has to be either mdl or UsdPreviewSurface.
    """
)

def Xform "World"
{
    def Cube "cube_valid_surface_shader_mdl" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/cube_valid_surface_shader_mdl>
    }

    def Cube "cube_valid_surface_shader_ups" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/cube_valid_surface_shader_ups>
    }

    def Scope "Looks"
    {
        def Material "cube_valid_surface_shader_mdl"
        {
            token outputs:mdl:surface.connect = </World/Looks/cube_valid_surface_shader_mdl/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR"
                token outputs:out
            }
        }

        def Material "cube_valid_surface_shader_ups"
        {
            token outputs:surface.connect = </World/Looks/cube_valid_surface_shader_ups/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                token outputs:surface
            }
        }
    }
}
