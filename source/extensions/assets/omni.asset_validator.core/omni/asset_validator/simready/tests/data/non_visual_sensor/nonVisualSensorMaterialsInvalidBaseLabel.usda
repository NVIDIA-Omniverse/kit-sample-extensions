#usda 1.0
(
    defaultPrim = "World"
    """
    This USD presents materials with invalid 'inputs:nonvisual:base' - incorrect value, not defined
    """
)

def Xform "World"
{
    def Cube "Cube_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_base_label>
    }

    def Cube "Cube_02" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/invalid_base_not_defined>
    }

    def Scope "Looks"
    {
        def Material "invalid_base_label"
        {
            token omni:simready:nonvisual:base = "something"
            token omni:simready:nonvisual:coating = "clearcoat"
            token[] omni:simready:nonvisual:attributes = ["none"]
        }

        def Material "invalid_base_not_defined"
        {
            token omni:simready:nonvisual:coating = "clearcoat"
            token[] omni:simready:nonvisual:attributes = ["none"]
        }
    }
}
