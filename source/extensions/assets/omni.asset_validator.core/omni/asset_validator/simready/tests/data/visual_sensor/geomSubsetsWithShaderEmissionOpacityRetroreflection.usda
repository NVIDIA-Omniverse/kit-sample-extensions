#usda 1.0
(
    defaultPrim = "World"
    """
    This USD presents geomsubsets with materials that have opacity, emissive, retroreflection enabled.
    """
)

def Xform "World"
{
    def Mesh "Cube_GeomSubset_01" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 0, 4, 5, 1, 1, 5, 6, 3, 2, 3, 6, 7, 0, 2, 7, 4, 4, 7, 6, 5]
        point3f[] points = [(-50, -50, -50), (50, -50, -50), (-50, -50, 50), (50, -50, 50), (-50, 50, -50), (50, 50, -50), (50, 50, 50), (-50, 50, 50)]

        def GeomSubset "first" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0, 1]
            rel material:binding = </World/Looks/valid_material>
        }
        def GeomSubset "second" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [4, 5]
            rel material:binding = </World/Looks/material_enable_opacity>
        }

        def GeomSubset "third" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [2, 3]
            rel material:binding = </World/Looks/material_enable_emission>
        }
    }


    def Mesh "Cube_GeomSubset_02" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 0, 4, 5, 1, 1, 5, 6, 3, 2, 3, 6, 7, 0, 2, 7, 4, 4, 7, 6, 5]
        point3f[] points = [(-50, -50, -50), (50, -50, -50), (-50, -50, 50), (50, -50, 50), (-50, 50, -50), (50, 50, -50), (50, 50, 50), (-50, 50, 50)]

        rel material:binding = </World/Looks/material_enable_retroreflection>

        def GeomSubset "first" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0, 1]
        }

        def GeomSubset "second" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [4, 5]
            rel material:binding = </World/Looks/material_opacity_enable_emission>
        }
    }

    def Mesh "Cube_GeomSubset_03" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 0, 4, 5, 1, 1, 5, 6, 3, 2, 3, 6, 7, 0, 2, 7, 4, 4, 7, 6, 5]
        point3f[] points = [(-50, -50, -50), (50, -50, -50), (-50, -50, 50), (50, -50, 50), (-50, 50, -50), (50, 50, -50), (50, 50, 50), (-50, 50, 50)]

        rel material:binding = </World/Looks/valid_material>

        def GeomSubset "first" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0, 1]
        }

        def GeomSubset "second" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [4, 5]
            rel material:binding = </World/Looks/valid_material_material_both_mdl_universal_context>
        }
    }

    def Scope "Looks"
    {
        def Material "valid_material"
        {
            token outputs:surface.connect = </World/Looks/valid_material/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"

                bool inputs:enable_opacity = false
                bool inputs:enable_emission = false
                bool inputs:enable_retroreflection = false
                token outputs:out
            }
        }

        def Material "material_enable_opacity"
        {
            token outputs:surface.connect = </World/Looks/material_enable_opacity/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"

                bool inputs:enable_opacity = true
                bool inputs:enable_emission = false
                bool inputs:enable_retroreflection = false
                token outputs:out
            }
        }

        def Material "material_enable_emission"
        {
            token outputs:surface.connect = </World/Looks/material_enable_emission/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR"

                bool inputs:enable_opacity = false
                bool inputs:enable_emission = true
                bool inputs:enable_retroreflection = false
                token outputs:out
            }
        }

        def Material "material_enable_retroreflection"
        {
            token outputs:surface.connect = </World/Looks/material_enable_retroreflection/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR_Translucent.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR_Translucent"

                bool inputs:enable_opacity = false
                bool inputs:enable_emission = false
                bool inputs:enable_retroreflection = true
                token outputs:out
            }
        }

        def Material "material_opacity_enable_emission"
        {
            token outputs:surface.connect = </World/Looks/material_opacity_enable_emission/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR"

                bool inputs:enable_opacity = true
                bool inputs:enable_emission = true
                bool inputs:enable_retroreflection = false
                token outputs:out
            }
        }

        def Material "valid_material_both_mdl_universal_context"
        {
            token outputs:mdl:surface.connect = </World/Looks/valid_material_both_mdl_universal_context/NoOpacity.outputs:out>
            token outputs:surface.connect = </World/Looks/valid_material_both_mdl_universal_context/Opacity.outputs:out>
            def Shader "Opacity"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR"

                bool inputs:enable_opacity = true
                bool inputs:enable_emission = false
                bool inputs:enable_retroreflection = false
                token outputs:out
            }
            def Shader "NoOpacity"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @SimPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "SimPBR"

                bool inputs:enable_opacity = false
                bool inputs:enable_emission = false
                bool inputs:enable_retroreflection = false
                token outputs:out
            }
        }
    }
}
