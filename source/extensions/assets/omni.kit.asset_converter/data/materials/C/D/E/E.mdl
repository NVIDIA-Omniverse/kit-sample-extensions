mdl 1.8;

import ::df::*;
import ::tex::*;
import ::state::*;
import ..::..::F::F::*;

export material E(uniform texture_2d tex = texture_2d("white.png")) = let {
    float3 tex_coord3 = state::texture_coordinate(0);
    float2 tex_coord = float2(tex_coord3.x, tex_coord3.y);
    color tint = tex::lookup_color(tex, tex_coord);
    uniform texture_2d udim_tex = texture_2d("../../F/tile.<UDIM>.png");
    color tint2 = tex::lookup_color(udim_tex, tex_coord);
} in material(
    surface: material_surface(
        scattering: df::diffuse_reflection_bsdf(
            tint: tint * tint2 * tex::lookup_color(texture_2d("../../../green.png"), tex_coord) * ::F::F::F()
        )
    )
);
