# Normalize text files on commit to LF endings by default
* text=auto
# Make sure Windows batch files preserve CR/LF line endings, otherwise they may not be able to execute.  Windows
# batch files require a CR/LF for labels to work properly, otherwise they may fail when labels straddle 512-byte
# block boundaries.  This is important when files are downloaded through a zip archive that was authored on a
# Linux machine (the default behavior on GitHub)
*.bat text eol=crlf
*.cmd text eol=crlf
# Make sure shell scripts have LF line endings, even when checked out on a Windows client with autocrlf=true
*.sh text eol=lf

# Track binary image files with Git LFS
*.png  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text

# Track binary USD files with Git LFS
*.usd  filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text

# Track binary font files with Git LFS
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Track binary audio files with Git LFS
*.wav filter=lfs diff=lfs merge=lfs -text

# Track binary archives and packages with Git LFS
*.sbsar filter=lfs diff=lfs merge=lfs -text
*.7z   filter=lfs diff=lfs merge=lfs -text
*.zip  filter=lfs diff=lfs merge=lfs -text

# Track binary documents with Git LFS
*.pdf filter=lfs diff=lfs merge=lfs -text

# Track binary data files with Git LFS
*.bin filter=lfs diff=lfs merge=lfs -text

# Track binary libraries and executables with Git LFS
*.so   filter=lfs diff=lfs merge=lfs -text
*.so.1 filter=lfs diff=lfs merge=lfs -text
*.dll  filter=lfs diff=lfs merge=lfs -text
*.lib  filter=lfs diff=lfs merge=lfs -text
*.a    filter=lfs diff=lfs merge=lfs -text

# All files under docs/images go into Git LFS
docs/images/** filter=lfs diff=lfs merge=lfs -text
# All files under data directories go into Git LFS
data/** filter=lfs diff=lfs merge=lfs -text
source/extensions/**/data/** filter=lfs diff=lfs merge=lfs -text
source/extensions/**/light_rig_data/** filter=lfs diff=lfs merge=lfs -text
source/extensions/**/samples_data/** filter=lfs diff=lfs merge=lfs -text
source/extensions/**/icons/** filter=lfs diff=lfs merge=lfs -text

# Exclude text file types from LFS (overrides directory patterns above)
*.usda  !filter !diff !merge text
*.svg   !filter !diff !merge text
*.json  !filter !diff !merge text
*.txt   !filter !diff !merge text
*.csv   !filter !diff !merge text
*.html  !filter !diff !merge text
*.mdl   !filter !diff !merge text
*.macro !filter !diff !merge text
*.wrapp !filter !diff !merge text
*.xlf   !filter !diff !merge text
*.sbs   !filter !diff !merge text

